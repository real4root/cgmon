#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/opt/cgmon/cgmon
CONF=/etc/cgmon/cgmon.yaml

start_service() {
    i=0

    while [ ! -x "$PROG" ]; do
        i=$((i + 1))

        if [ "$i" -ge 60 ]; then
            echo "cgmon: $PROG still missing after 60s" >&2
            return 1
        fi

        sleep 1
    done

    [ -f "$CONF" ] || {
        echo "cgmon: config not found: $CONF" >&2
        return 1
    }

    procd_open_instance cgmon
    procd_set_param command "$PROG" daemon -config "$CONF"
    procd_set_param respawn 3600 10 10
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$CONF"
    procd_close_instance
}
